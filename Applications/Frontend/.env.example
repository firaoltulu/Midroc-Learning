# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base path of the REST API as seen by the browser
VITE_API_BASE=/api

# Optional: host:port of the Firebase Auth emulator, e.g. 127.0.0.1:9099
VITE_FIREBASE_EMULATOR=

# Dev server only: where /api is proxied to
VITE_DEV_API_TARGET=http://localhost:3000
