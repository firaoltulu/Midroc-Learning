{
  "name": "midroc-learning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "vite build --mode development --outDir .typecheck-dist && tsc --noEmit",
    "lint": "eslint src e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "prettier --write src e2e vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json eslint.config.js .prettierrc.json index.html",
    "format:check": "prettier --check src e2e vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json eslint.config.js .prettierrc.json index.html",
    "i18n:check": "node -e \"console.log('i18n:check is a placeholder until the internationalization phase.')\"",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "gen:api": "openapi-typescript reference/openapi.yaml -o src/shared/api/schema.d.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@tanstack/react-query": "^5.87.0",
    "@tanstack/react-router": "^1.132.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^16.10.2",
    "eslint": "^9.35.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
